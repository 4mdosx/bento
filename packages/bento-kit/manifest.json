{
  "$schema": "./manifest.schema.json",
  "version": "1.0.0",
  "capabilities": [
    {
      "name": "button",
      "layer": "primitive",
      "delivery": "source",
      "entry": "registry/button/Button.tsx",
      "dependencies": ["@radix-ui/react-slot"],
      "exports": ["Button", "ButtonProps"],
      "propsSchema": "ButtonHTMLAttributes<HTMLButtonElement> & { loading?: boolean; loadingIndicator?: ReactNode; asChild?: boolean }",
      "examples": ["apps/docs/src/component-docs/definitions.tsx"],
      "useCases": ["filterable-resource-list", "resource-detail"]
    },
    {
      "name": "list-host",
      "layer": "host",
      "delivery": "package",
      "entry": "bento-kit/hosts/list",
      "dependencies": ["react", "bento-kit/core"],
      "exports": ["ListHost", "useListHost", "ListModel", "ListActions", "ListViewModel"],
      "propsSchema": "ListHostProps<Item>",
      "examples": ["apps/docs/src/component-docs/examples/ResourceListExample.tsx"],
      "useCases": ["filterable-resource-list"]
    },
    {
      "name": "list",
      "layer": "view",
      "delivery": "source",
      "entry": "registry/list/ListView.tsx",
      "dependencies": ["bento-kit/hosts/list"],
      "exports": ["ListView"],
      "propsSchema": "{ host: ListHostValue<Item>; renderItem(item): ReactNode }",
      "examples": ["apps/docs/src/component-docs/examples/ResourceListExample.tsx"],
      "useCases": ["filterable-resource-list"]
    },
    {
      "name": "detail-presentation",
      "layer": "view",
      "delivery": "source",
      "entry": "registry/detail/DetailView.tsx",
      "dependencies": ["bento-kit/ui-runtime/overlay"],
      "exports": ["DetailView"],
      "propsSchema": "DetailPresentationProps",
      "examples": ["apps/docs/src/component-docs/examples/DetailExample.tsx"],
      "useCases": ["resource-detail"]
    },
    {
      "name": "overlay-runtime",
      "layer": "ui-runtime",
      "delivery": "package",
      "entry": "bento-kit/ui-runtime/overlay",
      "dependencies": ["react", "react-dom"],
      "exports": ["OverlayProvider", "OverlayRoot"],
      "propsSchema": "OverlayProviderProps",
      "examples": ["apps/docs/src/component-docs/examples/DetailExample.tsx"],
      "useCases": ["resource-detail"]
    },
    {
      "name": "dashboard-shell",
      "layer": "layout",
      "delivery": "source",
      "entry": "registry/dashboard-shell/DashboardShell.tsx",
      "dependencies": [],
      "exports": ["DashboardShell"],
      "propsSchema": "DashboardShellProps",
      "examples": ["apps/docs/app/layout.tsx"],
      "useCases": ["application-shell"]
    },
    {
      "name": "documentation",
      "layer": "view",
      "delivery": "source",
      "entry": "registry/documentation/Documentation.tsx",
      "dependencies": [],
      "exports": ["SiteHeader", "SiteFooter", "Page", "DocsLayout", "DocsSidebar", "CardGrid", "Card", "CodeBlock", "Callout"],
      "propsSchema": "Semantic presentation props with ReactNode slots",
      "examples": ["apps/docs/app/page.tsx", "apps/docs/app/getting-started/page.tsx"],
      "useCases": ["documentation-site"]
    }
  ]
}
