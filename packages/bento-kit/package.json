{
  "name": "bento-kit",
  "version": "0.1.0-preview.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bento": "./cli/command.js",
    "bento-kit": "./cli/command.js"
  },
  "files": [
    "dist",
    "cli/*.js",
    "cli/package.json",
    "templates",
    "registry",
    "manifest.json",
    "manifest.schema.json",
    "README.md"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css",
    "test": "node --test",
    "prepack": "npm run build && node scripts/copy-registry.mjs"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./hosts": { "types": "./dist/hosts/index.d.ts", "import": "./dist/hosts/index.js" },
    "./hosts/list": { "types": "./dist/hosts/list/index.d.ts", "import": "./dist/hosts/list/index.js" },
    "./integrations/next": { "types": "./dist/integrations/next/index.d.ts", "import": "./dist/integrations/next/index.js" },
    "./ui-runtime": { "types": "./dist/ui-runtime/index.d.ts", "import": "./dist/ui-runtime/index.js" },
    "./ui-runtime/overlay": { "types": "./dist/ui-runtime/overlay/index.d.ts", "import": "./dist/ui-runtime/overlay/index.js" },
    "./views": { "types": "./dist/views/index.d.ts", "import": "./dist/views/index.js" },
    "./manifest.json": "./manifest.json",
    "./theme.css": "./dist/theme.css"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "clsx": "^2.1.0",
    "commander": "^12.1.0",
    "lucide-react": "^0.344.0",
    "tailwind-merge": "^2.2.0"
  },
  "peerDependencies": {
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  }
}
