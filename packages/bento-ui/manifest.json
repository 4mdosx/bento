{
  "$schema": "./manifest.schema.json",
  "version": "1.0.0",
  "capabilities": [
    {
      "name": "list-host",
      "layer": "host",
      "delivery": "package",
      "entry": "bento-ui/hosts/list",
      "dependencies": ["react", "bento-ui/core"],
      "exports": ["ListHost", "useListHost", "ListModel", "ListActions", "ListViewModel"],
      "propsSchema": "ListHostProps<Item>",
      "examples": ["apps/playground/src/demos/list/ResourceListDemo.tsx"],
      "useCases": ["filterable-resource-list"]
    },
    {
      "name": "list",
      "layer": "view",
      "delivery": "source",
      "entry": "registry/list/ListView.tsx",
      "dependencies": ["bento-ui/hosts/list"],
      "exports": ["ListView"],
      "propsSchema": "{ host: ListHostValue<Item>; renderItem(item): ReactNode }",
      "examples": ["apps/playground/src/demos/list/ResourceListDemo.tsx"],
      "useCases": ["filterable-resource-list"]
    },
    {
      "name": "detail-presentation",
      "layer": "view",
      "delivery": "source",
      "entry": "registry/detail/DetailView.tsx",
      "dependencies": ["bento-ui/ui-runtime/overlay"],
      "exports": ["DetailView"],
      "propsSchema": "DetailPresentationProps",
      "examples": ["apps/playground/src/demos/detail/DetailDemo.tsx"],
      "useCases": ["resource-detail"]
    },
    {
      "name": "overlay-runtime",
      "layer": "ui-runtime",
      "delivery": "package",
      "entry": "bento-ui/ui-runtime/overlay",
      "dependencies": ["react", "react-dom"],
      "exports": ["OverlayProvider", "OverlayRoot"],
      "propsSchema": "OverlayProviderProps",
      "examples": ["apps/playground/src/demos/detail/DetailDemo.tsx"],
      "useCases": ["resource-detail"]
    },
    {
      "name": "dashboard-shell",
      "layer": "layout",
      "delivery": "source",
      "entry": "registry/dashboard-shell/DashboardShell.tsx",
      "dependencies": [],
      "exports": ["DashboardShell"],
      "propsSchema": "DashboardShellProps",
      "examples": ["apps/playground/components/ShellLayout.tsx"],
      "useCases": ["application-shell"]
    }
  ]
}
