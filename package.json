{
  "name": "@4mdosx/bento",
  "version": "0.0.1",
  "description": "Quick Start Kit for Web Applications",
  "main": "index.js",
  "bin": { "bento": "packages/bento-kit/cli/command.js" },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run dev -w docs",
    "dev:docs": "npm run dev -w docs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build -w bento-kit && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:agent": "node scripts/evaluate-agent.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "test": "node --test packages/bento-kit/cli/test/*.test.js && npm run test --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:package && npm run verify:agent"
  },
  "keywords": [
    "cli",
    "next",
    "react",
    "full-stack",
    "template"
  ],
  "author": "4mdosx",
  "license": "ISC",
  "dependencies": {
    "commander": "^12.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
